# ============================================================
# Variables de entorno para Producción (VPS)
# ============================================================
# Copiar este archivo como .env y completar los valores
# cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_DB=whatsapp_mvp
POSTGRES_USER=wamvp_user
POSTGRES_PASSWORD=ACA_TU_PASSWORD_SEGURO

# WhatsApp Service
WA_SERVICE_PORT=3001
WA_SESSION_NAME=default
WA_WEBHOOK_SECRET=ACA_TU_SECRET_WEBHOOK

# Backend
JWT_SECRET=ACA_UN_SECRET_MINIMO_64_CHARS_PARA_JWT_SEGURO
JWT_EXPIRATION_MS=86400000

# IA (Groq o OpenAI)
GROQ_API_KEY=ACA_TU_API_KEY_GROQ
AI_MODEL=llama3-8b-8192
AI_BASE_URL=https://api.groq.com/openai/v1

# Admin
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD=tu_password_seguro
ADMIN_PHONE=573123197433
